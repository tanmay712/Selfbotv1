# VOID Selfbot — Configuration
# Get your Discord token (user token) by opening Discord in browser, DevTools → Application → Local Storage → token

TOKEN=your_discord_token_here
PREFIX=;
OWNER_ID=your_discord_user_id_here

# Optional: AI chat command (llm)
GROQ_API_KEY=

# Dashboard config
DASH_PORT=8484
DASH_AUTO_OPEN=true
DASH_PASSWORD=void
