{
  "version": 2,
  "public": false,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*\\.(?:js|css|html|png|svg|ico|json))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
